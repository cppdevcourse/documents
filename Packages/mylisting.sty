\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mylisting}

\RequirePackage{minted}
\RequirePackage[minted]{tcolorbox}
\RequirePackage{kvoptions}
\RequirePackage{accsupp}

% Исправление копирования кода из PDF: в lualatex пробел catcode 10
% в verbatim вёрстается как glue без глифа (стандартное
% определение \FV@Space из fvextra), и PDF-вьюеры при копировании
% теряют такие «невидимые» отступы.
% Здесь пробел заменяется реальным глифом U+0020, а
% \FancyVerbSpaceBreak сохраняется (разрыв строки на пробеле
% при breaklines). Переопределение выполняется при входе в каждое
% verbatim-окружение; запись добавляется в \FV@FormattingPrep@PreHook
% позже записи \FV@DefFVSpace самого fvextra, поэтому выполняется
% после неё и переопределяет \FV@Space. Режим showspaces
% (видимые пробелы) не затрагивается. Блок устанавливается один раз:
% этот же код есть и в terminal.sty, оба пакета могут быть
% загружены в одном документе.
\@ifundefined{FV@CopyableSpaceHook@done}{%
  \gdef\FV@CopyableSpaceHook@done{}%
  \g@addto@macro\FV@FormattingPrep@PreHook{%
    \ifbool{FV@showspaces}{}{%
      \def\FV@Space{\char"0020\FancyVerbSpaceBreak}%
    }%
  }%
}{}%

\SetupKeyvalOptions{
    family=MLS,
    prefix=MLS@
}

\DeclareStringOption[\normalsize]{fontsize}
\DeclareStringOption[\footnotesize]{linenosfontsize}
\DeclareStringOption[0mm]{bskip}
\DeclareStringOption[0mm]{askip}

\ProcessKeyvalOptions*

\newcommand{\HideFromCopy}[1]{%
    \BeginAccSupp{ActualText={}}#1\EndAccSupp{}%
}

\renewcommand{\theFancyVerbLine}{
    \HideFromCopy{\MLS@linenosfontsize\ttfamily\textcolor{gray}{\arabic{FancyVerbLine}}}
}

\tcbset{
    listingbase/.style={
        listing engine=minted,
        minted options={
            fontsize=\MLS@fontsize,
            breaklines,
            breakanywhere,
            linenos,
            escapeinside=||,
            numbersep=2pt
        },
        listing only,
        left skip=0mm,
        right skip=0mm,
        after skip=\MLS@askip,
        before skip=\MLS@bskip,
        left=0mm,
        right=0mm,
        top=0mm,
        bottom=0mm,
        boxrule=0.02cm,
        colback=white,
        colframe=black,
        colbacktitle=gray!10!white,
        coltitle=black,
        sharp corners
    }
}

\newtcbinputlisting{\myinputlisting}[3][]{%
    listing file={#2#3},
    title=#3,
    fonttitle=\it\MLS@fontsize,
    listingbase,
    #1
}

\newtcblisting{myinplacelisting}[1][]{%
    listingbase,
    #1
}

\NewTCBListing{mycppinplacelisting}{!O{}}{%
    listingbase,
    minted language=cpp,
    #1
}

\newtcblisting{mytitledinplacelisting}[2][]{%
    listingbase,
    title={#2},
    #1
}

\NewTCBListing{mycpptitledinplacelisting}{O{}m}{%
    listingbase,
    minted language=cpp,
    title={#2},
    #1
}
